\newlabel{fig:m2vsm3}{{6}{5}{Module 2 \texttt {std::thread} versus Module 3 OpenMP, uniform input. (a) absolute time, (b) speedup against the shared sequential baseline, (c) efficiency $= \text {speedup}/T$ over the full thread range $T\in \{1,\ldots ,32\}$. The vertical line marks $T{=}20$, physical-core saturation}{figure.caption.10}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Module 2 \texttt  {std::thread} vs Module 3 OpenMP, uniform $N_R{=}10^7$, $N_S{=}2{\cdot }10^7$. The first row is the shared sequential baseline ($0.735$~s, current \texttt  {hashjoin\_seq} mean of 3 runs); both columns of speedups are $T_{\text  {seq}}/T(p)$. The Mod2 row at $T{=}1$ is below unity because the \texttt  {std::thread} pool already pays the cost of one worker plus a queue handshake. The optimisations of Section~\ref {sec:opt} apply to Module~3 only.}}{5}{table.caption.11}\protected@file@percent }
\newlabel{tab:m2}{{2}{5}{Module 2 \texttt {std::thread} vs Module 3 OpenMP, uniform $N_R{=}10^7$, $N_S{=}2{\cdot }10^7$. The first row is the shared sequential baseline ($0.735$~s, current \texttt {hashjoin\_seq} mean of 3 runs); both columns of speedups are $T_{\text {seq}}/T(p)$. The Mod2 row at $T{=}1$ is below unity because the \texttt {std::thread} pool already pays the cost of one worker plus a queue handshake. The optimisations of Section~\ref {sec:opt} apply to Module~3 only}{table.caption.11}{}}
